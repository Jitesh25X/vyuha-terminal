# Copy to .env (never commit .env). All services read from environment.
# ── General ───────────────────────────────────────────────
VYUHA_ENV=dev                         # dev | staging | prod
PUBLIC_BASE_URL=https://localhost:8443  # external origin; broker redirect URLs = <this>/api/v1/brokers/callback/<broker> (register them in the Kite / Upstox app)
TZ_DISPLAY=Asia/Kolkata
LIVE_TRADING_ENABLED=false            # owner-only switch; requires VYUHA_ENV=staging|prod

# 32-byte base64 key for AES-256-GCM secret envelope. Dev: `make dev-secrets` fills it into .env. Back it up: TOTP secrets are encrypted with it.
VYUHA_MASTER_KEY=

# ── Auth ──────────────────────────────────────────────────
JWT_SIGNING_KEY_PATH=./deploy/secrets/jwt_ed25519.pem   # dev: make dev-secrets (Ed25519 PKCS#8 PEM)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# ── Datastores ────────────────────────────────────────────
POSTGRES_URL=postgres://vyuha:vyuha@localhost:5432/vyuha?sslmode=disable
POSTGRES_READONLY_URL=postgres://vyuha_ro:vyuha_ro@localhost:5432/vyuha?sslmode=disable
CLICKHOUSE_URL=clickhouse://vyuha:vyuha@127.0.0.1:9000/vyuha  # dev user from docker-compose.dev.yml
QUANT_URL=http://127.0.0.1:8090        # gateway → quant internal API (loopback only; no auth)
QUANT_HTTP_ADDR=127.0.0.1:8090         # where `vyuha-quant serve` listens
RISK_FREE_RATE=0.055                   # decimal; RBI policy repo rate (5.50 % since 2026-10-07) — admin keeps it current
RISK_FREE_RATE_AS_OF=2026-10-07        # date the rate took effect (shown in the OC footer); required with RISK_FREE_RATE
IV_MID_MAX_SPREAD=0.10                 # IV from the mid only when spread <= 10 % of the mid ...
IV_LTP_MAX_AGE_S=60                    # ... else from the LTP only if it traded within 60 s; else no IV
CLICKHOUSE_READONLY_URL=clickhouse://readonly:@localhost:9000/vyuha
NATS_URL=nats://localhost:4222
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-dev
NEO4J_READONLY_USER=reader
NEO4J_READONLY_PASSWORD=change-me-dev
DATA_LAKE_DIR=./data/lake
MODELS_DIR=./data/models               # embedding model cache (bge-m3 only, downloaded at M6.2)

# ── Gateway ───────────────────────────────────────────────
GATEWAY_HTTP_ADDR=127.0.0.1:8080       # Caddy proxies /api and /ws here (use :8080 inside a container)
TRUSTED_PROXIES=                       # IPs/CIDRs whose X-Forwarded-For is believed. Empty = loopback (dev); required in staging/prod (Caddy's address, or "none")

# ── Engine ────────────────────────────────────────────────
ENGINE_GRPC_ADDR=127.0.0.1:7443
WS_ALLOWED_ORIGINS=                    # extra browser origins allowed on /ws, comma-separated host patterns (same origin is always allowed)
ENGINE_CORE_CPU=2                      # CPU to pin the core thread
IP_ECHO_URL=                           # optional: URL returning caller's public IP, for egress check
MAX_CLOCK_SKEW_MS=250

# ── Risk / pricing ────────────────────────────────────────
RISK_FREE_RATE=0.055                   # admin sets from current RBI policy repo rate
DEFAULT_MARKET_PROTECTION_PCT=2.0

# ── AI ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic                 # anthropic | openai_compat
LLM_BASE_URL=                          # for openai_compat (local vLLM/Ollama)
LLM_MODEL_FAST=                        # extraction model id, pinned in TECH_STACK.md §6
LLM_MODEL_SMART=                       # copilot model id
EMBEDDING_MODEL=BAAI/bge-m3
COPILOT_DAILY_TOKEN_BUDGET_PER_USER=2000000
EVAL_MAX_USD=5

# ── Observability ─────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=                # http://localhost:4317 once the obs profile runs (M3.8); empty = no export
LOG_LEVEL=info

# Broker API keys/secrets are NOT env vars: they are entered per account in the admin console
# and stored encrypted in Postgres.

# Build context for deploy/staging/*.Dockerfile (repo root). Secrets never enter an image.
**/.env
**/.env.*
deploy/secrets/
deploy/staging/secrets/
**/*.pem
**/*.key
.git/
.github/
.claude/
/data/
docs/
intel/

# build outputs and caches (images build their own)
engine/build/
engine/vcpkg_installed/
gateway/bin/
web/dist/
web/test-results/
web/playwright-report/
**/node_modules/
**/.venv/
**/__pycache__/
**/.mypy_cache/
**/.ruff_cache/
**/.pytest_cache/
# Generated protobuf code is gitignored but IS needed: run `make proto` before building (make staging-build).
